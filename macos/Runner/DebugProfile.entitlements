<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is off, not omitted by oversight: SPEC.md §13 distributes
	     outside the Mac App Store (signed/notarized .app/.dmg), and the core
	     feature is reading arbitrary user-selected .duckdb files anywhere on
	     disk (including a Steam-installed game's telemetry folder) — exactly
	     what App Sandbox restricts without security-scoped bookmark plumbing
	     the app has no other use for. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Required even though App Sandbox is off.
	     `file_picker_darwin` gates every open/save panel behind a
	     `SecTaskCopyValueForEntitlement` check for one of the two
	     `files.user-selected` entitlements, and it does *not* first ask whether
	     the process is sandboxed. Without this key the check fails and
	     `pickFile()` throws `ENTITLEMENT_NOT_FOUND` in ~6 ms — the panel never
	     appears at all, which reads to a user as the button doing nothing.
	     `read-only` rather than `read-write` because §3 makes writing back to a
	     recording a non-goal; the plugin accepts either for opening. Outside the
	     sandbox the key grants nothing — it exists solely to satisfy that check. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
